// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "helix_mode": true,
  "theme": "Oxocarbon OLED Monochrom",
  "ui_font_family": "Lucida Grande",
  "ui_font_size": 16,
  "buffer_font_family": "Lucida Grande Mono DK",
  "buffer_font_size": 14,
  "terminal": {
    "font_size": 12.0
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "indent_guides": {
    "enabled": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  }
}
