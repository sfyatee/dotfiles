# init kak-plug
evaluate-commands %sh{
    bundle="$kak_config/bundle"
    mkdir -p "$bundle"
    [ ! -e "$bundle/kak-bundle" ] && \
        git clone -q https://codeberg.org/jdugan6240/kak-bundle.git "$bundle/kak-bundle"
    printf "%s\n" "source '$bundle/kak-bundle/rc/kak-bundle.kak'"
}
bundle-noload kak-bundle https://codeberg.org/jdugan6240/kak-bundle

# turn off the noise
# set global autoinfo ""
set global ui_options terminal_assistant=off

# enough is enough...
set global disabled_hooks '.+-highlight'

# load config files
define-command load -params 2 %{
    source "%val{config}/%arg{1}/%arg{2}.kak"
}

# load plugins
load rc plugins

# colorscheme and defaults
load rc options

# minor color config
colorscheme default

# subtle statusline
face global StatusLine cyan,rgb:0f242a

# configure the color of the column
addhl global/ column '%opt{textwidth}' default,rgb:404040

# granular settings
load filetype aerc
load filetype go
