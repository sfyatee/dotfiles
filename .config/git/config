[user]
	name = Demian Garcia
	email = dag@demians.org
[github]
	login = sfyatee
[color]
	ui = never
[alias]
	br = branch
	ci = commit
	cl = clone
	co = checkout
	cy = cherry-pick
	di = diff
	se = push
	st = status -s
	sw = switch
[commit]
	verbose = yes
[init]
	defaultBranch = master
[pull]
	autostash = true
	rebase = true
[rebase]
	autosquash = true
[gc]
	reflogExpire = never
	writeCommitGraph = true
[rerere]
	enabled = true
	autoUpdate = true
[sendemail]
	annotate = yes
[format]
	thread = shallow
