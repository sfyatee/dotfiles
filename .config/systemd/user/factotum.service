[Unit]
Description=factotum
Documentation=man:factotum(4)
# Not supported by superd(1). PartOf/After options considered harmful?
# PartOf=graphical-session.target
# After=graphical-session.target

[Service]
Type=forking
Environment=PLAN9=/usr/local/plan9
Environment=PATH=/usr/bin:/usr/local/plan9/bin
Environment=secstore=localhost
ExecStart=/usr/local/plan9/bin/factotum

[Install]
WantedBy=default.target
