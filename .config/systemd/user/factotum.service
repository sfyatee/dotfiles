[Unit]
Description=User-level file system that acts as the authentication agent for a user
Documentation=man:factotum(4)

[Service]
Type=forking
Environment=PLAN9=/usr/local/plan9
Environment=PATH=/usr/bin:/usr/local/plan9/bin
Environment=secstore=localhost
ExecStart=/usr/local/plan9/bin/factotum

[Install]
WantedBy=default.target
