// -*- mode: jsonc -*-
{
    "reload_style_on_change": true,
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 40, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "margin": 24,
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "niri/window"
    ],
    "modules-right": [
        "pipewire",
        "network",
        "battery",
        "battery#bat2",
        "clock"
    ],
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // Force the wifi interface so we can bounce it on click
        "interface": "wlan0",

        // Poll fairly often so signal/labels react quickly
        "interval": 5,

	// Ethernet up -> "eth"
	"format-ethernet": "eth",

	// Wi-Fi connected -> plain "wifi" (we color this via CSS below)
	// Also expose % and dBm in the tooltip for debugging/visibility
	"format-wifi": "wifi",
	"tooltip-format-wifi": "{essid}  {signalStrength}%  ({signaldBm} dBm)",

	// Linked but no IP (still up but not connected)
	"format-linked": "wifi",

	// When rfkill blocks wifi, show the disabled state
	"rfkill": true,
	"format-disabled": "wifi",

	// When the displayed interface is disconnected, hide the module
	"format-disconnected": "",

	// Left-click: bounce the interface (choose ONE of the two lines)
	// If you use doas + ifconfig (like your script), use this:
	"on-click": "sh -c 'doas ifconfig wlan0 down; doas ifconfig wlan0 up'"
	// If you use NetworkManager instead, comment the line above and use:
	// "on-click": "sh -c \"nmcli radio wifi off; sleep 0.5; nmcli radio wifi on\""
	}
}
