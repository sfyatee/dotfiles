// Softer rounded corners.
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// Don't give focus to the GIMP startup splash screen.
window-rule {
    match app-id="^gimp" title="^GIMP Startup$"

    open-focused false
}

// Dim inactive windows. Credit: visualglitch91 @ Matrix.
/-window-rule {
    match is-focused=false
    opacity 0.4

    shadow {
        on
        inactive-color "#1D1D1FEB"
        spread 0
        softness 0
        offset x=0 y=0
        draw-behind-window true
    }
}

// When I was a child, I used to speak like a child, think like a child,
// reason like a child; when I became a man, I did away with childish
// things.
//
// -rob
//
// See: http://acme.cat-v.org/
window-rule {
    match title="acme"
    match app-id=r#"^org\._9front\.drawterm$"#
    open-maximized true
    open-on-workspace "felloff"
}

// Add rounded corners to fuzzel.
layer-rule {
    match namespace="^launcher$"
    geometry-corner-radius 12
}

// Block out notifications from screencast.
layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}
