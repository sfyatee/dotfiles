# to update: cat $HOME/lib/plumbing | 9p write plumb/rules

editor = acme

# view git commits/objects in acme
# https://groups.google.com/g/plan9port-dev/c/05yGHFBp4HU/m/WIjcZdkjBQAJ
type is text
data matches '[0-9a-f]*[a-f][0-9a-f]*'
data matches '([0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]+)'
plumb start rc -c 'cd '$wdir' && cd `{git rev-parse --show-toplevel} && test -d .git && git show '$1' | plumb -i -d edit -a ''action=showdata filename=+git/'$1''''

# ocaml error messages; thanks droyo
# duplicates are for dune's _build
type is text
data matches '.*[Ff]ile "([.a-zA-Z¡-￿0-9_/\-]*[a-zA-Z¡-￿0-9_/\-])", line ([0-9]+), characters ([0-9]+)-([0-9]+).*'$nl'?'
arg isfile      $1
data set        $file
attr add        addr=$2-#0+#$3,$2-#0+#$4
plumb to edit
plumb client $editor

