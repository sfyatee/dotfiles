# libre office - s[xt][cdigmw], doc, xls, ppt
data matches '[a-zA-Z¡-￿0-9_\-./@]+'
data matches '([a-zA-Z¡-￿0-9_\-./@]+)\.([Pp][Pp][Tt][Xx]?|[Dd][Oo][Cc][Xx]?|[Xx][Ll][Ss][Xx]?|[Ss][Xx][Dd])'
arg isfile	$0
plumb to libreoffice
plumb start libreoffice $file

# image files go to iv (https://github.com/wolfpld/moderncore)
type is text
data matches '[a-zA-Z¡-￿0-9_\-./@]+'
data matches '([a-zA-Z¡-￿0-9_\-./@]+)\.(jpe?g|JPE?G|gif|GIF|tiff?|TIFF?|ppm|bit|png|PNG)'
arg isfile	$0
plumb to image
plumb start iv $file

include basic
