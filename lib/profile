#!/bin/rc
umask 022

BOX=`{uname -snm}
os=`{echo $BOX(1) | tr '[:upper:]' '[:lower:]'}
arch=`{echo $BOX(3) | sed 's/x86_64/amd64/'}
path=(/usr/local/bin /usr/local/sbin /bin /usr/bin /sbin /usr/sbin /usr/X11R6/bin)
BIN=($home/bin $home/bin/$os $home/bin/$os/$arch)
PLAN9=/usr/local/plan9

# XDG
XDG_CACHE_HOME=$home/.cache
XDG_CONFIG_HOME=$home/.config
XDG_DATA_HOME=$home/.local/share

# XDG offenders...
# See: https://wiki.archlinux.org/title/XDG_Base_Directory#Partial
CARGO_HOME=$XDG_DATA_HOME/cargo
CUDA_CACHE_PATH=$XDG_CACHE_HOME/nv
NUGET_PACKAGES=$XDG_CACHE_HOME/NuGetPackages
RUFF_CACHE_DIR=$XDG_CACHE_HOME/ruff
RUSTUP_HOME=$XDG_DATA_HOME/rustup

append=(/usr/games /usr/games/bin $PLAN9/bin $PLAN9/bin/upas)
prepend=($BIN $home/.local/bin $home/go/bin $CARGO_HOME/bin)
path=($prepend $path $append)

# Browser used by web(1) and thus plumber.
BROWSER=firefox

# less(1): ok defaults
# https://github.com/jj-vcs/jj/commit/4967bd7
LESS=FRXi

# cvs(1)
CVS_RSH=/usr/bin/ssh
# got(1)
GOT_AUTHOR=('demian garcia <d@sfyatee.com>')

# Let gs find the plan9port document fonts.
GS_FONTPATH=$PLAN9/postscript/font

# When I was a child, I used to speak like a child, think like a child,
# reason like a child; when I became a man, I did away with childish
# things.
#
# -rob
NO_COLOR=1
CMAKE_COLOR_MAKEFILE=OFF
AV_LOG_FORCE_NOCOLOR=1

# Team Fortress 2
TF2=$home^'/.local/share/Steam/steamapps/common/Team Fortress 2/tf/custom'

# Unix means english and 24h clock. but do use UTF-8! and sort like a machine.
LANG=en_US.UTF-8
LC_CTYPE=$LANG
LC_COLLATE=C
LC_TIME=C

# TheFuture™
# "You MUST have an account, or else..."
# GitHub CLI
DO_NOT_TRACK=true
# Google
GOTELEMETRY=off
GOTOOLCHAIN=local
# LLM Garbage
CODEX_HOME=$XDG_CONFIG_HOME/codex
COPILOT_HOME=$XDG_CONFIG_HOME/copilot
CLAUDE_CONFIG_DIR=$XDG_CONFIG_HOME/claude
OLLAMA_MODELS=$XDG_DATA_HOME/ollama/models
# Silly needs...
_JAVA_AWT_WM_NONREPARENTING=1
MOZ_USE_XINPUT2=1

# cvs(1)
CVS_RSH=/usr/bin/ssh
# run0(1)
PACMAN_AUTH=run0
SYSTEMD_RUN_SHELL_PROMPT_PREFIX=(': ')

# rg(1)
FZF_DEFAULT_COMMAND='rg --files'

# 福山
HISTFILE=/dev/null
HISTSIZE=5000
LESSHISTFILE=/dev/null
MYSQL_HISTFILE=/dev/null
PYTHON_HISTORY=/dev/null

# Override $NAMESPACE (see intro(4)) because the default on MacOS is too long.
# See: https://github.com/rsc/tmp/blob/master/ssh-namespace-agent/main.go#L446
# This matches the default on other Unices when $WSYS is running.
# See: /usr/local/plan9/src/lib9/getns.c:43
NAMESPACE=/tmp/ns.$LOGNAME.:0

# Secstore considered harmful?
# See: https://9fans.topicbox.com/groups/9fans/T2e892f330bc0513b-M168e79b077a072dbe954da15
# See: https://lists.9front.org/9front/2024/April/1714325162.00
secstore=localhost

# special characters
tab='	'
nl='
'
cr='
'
fn :{}

# `{hostname -s} is not POSIX!
H=$BOX(2)
# Some hostnames get a '-'^'i++' suffix when a hostname matches an existing
# one on the network. Strip that off. Use $PLAN9/bin/stats for the truth...
# While at it also strip the *.{lan,home,local} suffix in hostnames. $BOX
h=`$ifs^'.-'{printf %s $H}
sys=$h(1)
h=()

# custom cd, pwd
pwd=`{pwd}
lwd=$pwd
fn prompt1{
	switch($pwd){
	case $home
		dir='~'
	case $home/*
		dir='~'^`{echo -n $pwd | sed 's#^'$home'##'}
	case *
		dir=$pwd
	}
	prompt=($"sys^':'^$dir^'% ')
}

# Change Working Directory (OSC 7)
# See: https://codeberg.org/dnkl/foot/wiki#shell-integration
fn osc7{
	enc=`{echo $pwd | sed 's/%/%25/g; s/ /%20/g'}
	p=`{printf '\033]7;file://%s%s\033\\' $H $enc}
	printf '%s' $"p
	# XXX: set -g allow-passthrough needed or not?
	# See: https://github.com/tmux/tmux/wiki/FAQ
	# "...it’s required to pass OSC 7 message to vt explicitely"
	# See: https://wiki.9front.org/plumber-vt
	# Do not delete this! This makes ctrl-shift+n spawn in $cwd.
	if(~ $"TMUX ?*) printf '\033Ptmux;\033%s\033\\' $"p
}

# Sets the label of the current X terminal window.
fn title{
	printf '\033]0;%s:%s%%\007' $sys $dir
}

fn hook{
	if(flag i){
		osc7
		prompt1
		title
	}
	status=''
}

fn cd{
	odir=$pwd

	switch($#*){
	case 0
		arg=()
	case 1
		switch($1){
		case -
			arg=$lwd
		case *
			arg=$1
		}
	case *
		arg=$*
	}

	if(builtin cd $arg){
		pwd=`{pwd}

		if(! ~ $odir $pwd)
			lwd=$odir

		hook
	}
}

fn cp{builtin cp -i $*}
fn hg{chg $*}
fn ivy{ivy-prompt}
fn lc{builtin lc -F $*}
fn ll{builtin ls -AFl $*}
fn ls{builtin ls -AF $*}
fn ltr{builtin ls -AlFtr $*}
fn mg{builtin mg -n $*}
fn mv{builtin mv -i $*}
fn ph{ps auwwx | head $*}
fn publicip{curl -4 -w '\n' -s http://ifconfig.me}
fn snarf{git --git-dir=$home/lib/dotfiles --work-tree=$home $*}

fn gl{
	got log $* | less
}

# Default font for Plan 9 programs.
font2=/mnt/font/LucidaGrande/11a/font
varfont=(-f $font2)
font=/mnt/font/LucidaGrandeMonoDK/11a/font
fixfont=(-F $font)

# http://man.9front.org/1/emacs
fn 9term{SHELL=hack $PLAN9/bin/9term $*}
fn acme{SHELL=hack $PLAN9/bin/acme -a $varfont $fixfont $*}
fn edwood{SHELL=hack builtin edwood -a $varfont $fixfont $*}
fn sam{builtin $PLAN9/bin/sam -a $*}

# When I say vi I mean kakoune (if it's installed).
kak=`{which kak >[2]/dev/null}
if(~ $#kak 1 && test -x $kak){
	fn vi{$kak $*}
	fn view{$kak -ro $*}
	EDITOR=$kak
}
if not{
	fn vi{/usr/bin/vi $*}
	fn view{/usr/bin/view $*}
	EDITOR=/usr/bin/vi
}

# For 9term and acme's win.
if(~ $#termprog 1 || ~ $#winid 1){
	# plumb files instead of starting new editor
	EDITOR=editinacme
	# get rid of backspace characters in Unix man output
	PAGER=nobs
	# make prompt executable
	prompt=($sys^':% ' $tab)
	fn $sys^':%' { if(! ~ $#* 0) $* }
	# sets the current window label using awd (see label(1))
	fn hook{ if(flag i) { awd }; status='' }; awd
	# no paging
	fn git{builtin git --no-pager $*}
	fn gl{
		root=`{git rev-parse --show-toplevel}
		got log $* |
			plumb -i -d edit -a ('action=showdata filename='^$root^'/+log')
	}
	fn hg{chg --pager=no $*}
	fn ivy{builtin ivy}
	fn jj{builtin jj --no-pager $*}
}
if not hook

# revpatch - reverse a patch
# 24may2020  +leah+
fn revpatch { interdiff -q $1 /dev/null }

# OS specificities.
switch($os){
case linux
	NPROC=`{nproc}
	fn ls{builtin ls -AFv $*}
	fn pQm{pacman -Qm}
	fn ph{ps auwwx | sort -rk 3,3 | head}
case openbsd
	if(test `{sysctl -n hw.ncpuonline} -gt 1) MP=.MP; if not MP=''
	fn cdg{cd /usr/src/sys/arch/`{machine}/compile/GENERIC^$MP}
	# https://www.omarpolo.com/post/enjoying-cdpath.html
	cdpath=(/usr/ports /usr/ports/mystuff)
	# check shared libs version
	# https://github.com/omar-polo/dotsnew/blob/main/kshrc.lp#L178C2-L178C29
	fn cshlib{
		libs=`{make show=SHARED_LIBS}

		while(! ~ $#libs 0){
			echo '===>' $libs(1)
			/usr/src/lib/check_sym \
				/usr/local/lib/lib$libs(1).so* \
				`{make show=WRKINST}/usr/local/lib/lib$libs(1).so*

			shift libs
			shift libs
		}
	}
	fn cvs{opencvs $*}
	fn mpldc{make port-lib-depends-check}
	fn mup{make update-patches}
	fn mupl{make update-plist $*}
	fn pclean{make clean='package plist'}
	fn rsync{openrsync $*}
}

if(! ~ $os linux){
	NPROC=`{sysctl -n hw.ncpu}
	stty status '^T'
}

# Use $NPROC for parallelism.
MAKEFLAGS=-j$NPROC
SAMUFLAGS=-j$NPROC

ulimit -c 0

# Make sure these are running.
fn felloff{
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Start factotum before secstore so it does not prompt for a password.
	if(! test -e $NAMESPACE/font) fontsrv &
	if(! test -e $NAMESPACE/factotum) factotum &
	if(! test -e $NAMESPACE/plumb) plumber &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `{9 ssh-agent}
}

if(test -d $PLAN9) felloff

# Site local config.
# . -q $home/lib/profile.local
