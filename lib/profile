#!/bin/rc
umask 022

# world
os=`{uname | tr '[:upper:]' '[:lower:]'}
arch=`{uname -m}
path=(/usr/local/bin /usr/local/sbin /usr/bin /bin /usr/sbin /sbin /usr/X11R6/bin)
BIN=($home/bin $home/bin/$os $home/bin/$os/$arch)
PLAN9=/usr/local/plan9

# browser used by web(1) and thus plumber
BROWSER=zen

# gameoftrees got(1)
GOT_AUTHOR=('demian garcia <sfyatee@sfyatee.com>')

# let gs find the plan9port document fonts
GS_FONTPATH=$PLAN9/postscript/font

# opts
CARGO_HOME=$home/.local/share/cargo
CUDA_CACHE_PATH=$home/.cache/nv
GOTELEMETRY=off
GOTOOLCHAIN=local
HISTFILE=/dev/null
HISTSIZE=500
LESS=-i
LESSHISTFILE=/dev/null
NO_COLOR=1
PYTHON_HISTORY=/dev/null
RUSTUP_HOME=$home/.local/share/rustup
XDG_CONFIG_HOME=$home/.config # for Apple

# path
append=($PLAN9/bin $PLAN9/bin/upas)
prepend=($BIN $home/go/bin $CARGO_HOME/bin)
path=($prepend $path $append)

# Unix means english and 24h clock. but do use UTF-8! and sort like a machine
LANG=en_US.UTF-8
LC_CTYPE=$LANG
LC_COLLATE=C
LC_TIME=C

# override $NAMESPACE; X is no more
NAMESPACE=/tmp/ns.$USER.:0

# default font for Plan 9 programs
font=/mnt/font/LucidaGrande/11a/font
font2=/mnt/font/LucidaGrandeMonoDK/11a/font

# 9
nine=➈
secstore=localhost

# prompt
# see: ../bin/openbsd/prompt2.go
fn prompt{
	sys=`{prompt2}
	ps1=' % '
	prompt=($"sys^$ps1)
	fn $sys^$ps1 { if(! ~ $#* 0) $* }
}
fn cd{
	if(~ $#* 0)
		builtin cd
	if not
		builtin cd $*
	prompt
}
prompt

# nice things to have
fn acme{SHELL=hack builtin acme -a -f $font -F $font2 $*}
fn cp{builtin cp -i $*}
fn edwood{builtin edwood -a -f $font -F $font2 $*}
fn hg{chg $*}
fn ivy{ivy-prompt}
fn lc{builtin lc -F $*}
fn ll{builtin ls -AFl $*}
fn ls{builtin ls -AF $*}
fn ltr{builtin ls -AlFtr $*}
fn m{make}
fn mg{builtin mg -n $*}
fn mu{muon}
fn mv{builtin mv -i $*}
fn ph{ps auwwx | head $*}
fn sam{builtin sam -a $*}

# when i say vi i mean helix (if it's installed)
fn vi{hx $*}
fn view{hx $*}
EDITOR=hx

# 9term and acme's win
if(~ $#termprog 1 || ~ $#winid 1){
	# sets the current window label using awd (see label(1))
	fn cd {
		# builtin cd $1 && flag i && awd
		# is not sufficient when running in a subshell
		# that is rc -e (like mk uses!)
		if(builtin cd $1){
			if(flag i) awd || status=''
			status=''
		}
	}
	awd
	# plumb files instead of starting new editor
	EDITOR=editinacme
	# get rid of backspace characters in Unix man output
	PAGER=nobs
	# plan 9 from bell labs
	prompt=('term% ' '	')
	if(~ $#SSH_TTY 1) prompt=('cpu% ' '	')
	fn term%{ $* }
	fn cpu%{ $* }
	# no paging
	fn git{builtin git --no-pager $*}
	fn hg{chg --pager=no $*}
	fn ivy{builtin ivy}
	fn jj{builtin jj --no-pager $*}
}

# revpatch - reverse a patch
# 24may2020  +leah+
fn revpatch { interdiff -q $1 /dev/null }

# os specificities
switch($os){
case linux
	BROWSER=zen-browser
	NPROC=`{nproc}
	fn ls{builtin ls -AFv $*}
	fn orphrem{sudo pacman -R `{pacman -Qdtq}}
	fn pQm{pacman -Qm}
	fn ph{ps auwwx | sort -rk 3,3 | head}
	fn rcctl{systemctl $*}
case openbsd
	cdpath=(. /usr/ports /usr/ports/mystuff)
	fn cvs{opencvs $*}
	fn mpldc{make port-lib-depends-check}
	fn mup{make update-patches}
	fn mupl{make update-plist $*}
	fn pclean{make clean='package plist'}
	fn rsync{openrsync $*}
}

if(! ~ $os linux){
	NPROC=`{sysctl -n hw.ncpu}
	stty status '^T'
}

# use $NPROC jobs
MAKEFLAGS=-j$NPROC
SAMUFLAGS=-j$NPROC

ulimit -c 0

# making sure these are running
fn felloff{
	mkdir -p $NAMESPACE
	9p stat plumb >[2]/dev/null >[1=2] || plumber
}

if(test -d $PLAN9) felloff
