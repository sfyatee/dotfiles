#!/bin/rc
umask 022

# world
os=`{uname | tr '[:upper:]' '[:lower:]'}
arch=`{uname -m | sed 's/x86_64/amd64/'}
path=(/usr/local/bin /usr/local/sbin /usr/bin /bin /usr/sbin /sbin /usr/X11R6/bin)
BIN=($home/bin $home/bin/$os $home/bin/$os/$arch)
PLAN9=/usr/local/plan9

# XDG
XDG_CACHE_HOME=$home/.cache
XDG_CONFIG_HOME=$home/.config # OSX is confused

# XDG offenders...
# See: https://wiki.archlinux.org/title/XDG_Base_Directory#Partial
CARGO_HOME=$home/.local/share/cargo
CUDA_CACHE_PATH=$home/.cache/nv
RUSTUP_HOME=$home/.local/share/rustup

# path
append=(/usr/games /usr/games/bin $PLAN9/bin $PLAN9/bin/upas)
prepend=($BIN $home/.local/bin $home/go/bin $CARGO_HOME/bin)
path=($prepend $path $append)

# Browser used by web(1) and thus plumber.
BROWSER=zen

# gameoftrees got(1)
GOT_AUTHOR=('demian garcia <d@sfyatee.com>')

# Let gs find the plan9port document fonts.
GS_FONTPATH=$PLAN9/postscript/font

# Unix means english and 24h clock. but do use UTF-8! and sort like a machine.
LANG=en_US.UTF-8
LC_CTYPE=$LANG
LC_COLLATE=C
LC_TIME=C

# mg(1)
EDITOR=mg

# less: ok defaults
# https://github.com/jj-vcs/jj/commit/4967bd7
LESS=FRXi

# TheFuture™
# "You MUST have an account, or else..."
# GitHub CLI
DO_NOT_TRACK=true
# Google
GOTELEMETRY=off
GOTOOLCHAIN=local

# When I was a child, I used to speak like a child, think like a child,
# reason like a child; when I became a man, I did away with childish
# things.
#
# -rob
NO_COLOR=1

# run0(1)
PACMAN_AUTH=run0
SYSTEMD_RUN_SHELL_PROMPT_PREFIX=('')

# The End of History?
HISTFILE=/dev/null
HISTSIZE=5000
LESSHISTFILE=/dev/null
PYTHON_HISTORY=/dev/null

# Override $NAMESPACE (see intro(4)) because the default on MacOS is too long.
# See: https://github.com/rsc/tmp/blob/master/ssh-namespace-agent/main.go#L446
# This matches the default on other Unices when $WSYS is running.
# See: /usr/local/plan9/src/lib9/getns.c:43
NAMESPACE=/tmp/ns.$LOGNAME.:0

# Default font for Plan 9 programs.
font2=/mnt/font/GoRegular/11a/font
varfont=(-f $font2)
font=/mnt/font/GoMono/11a/font
fixfont=(-F $font)

# Secstore considered harmful?
# See: https://9fans.topicbox.com/groups/9fans/T2e892f330bc0513b-M168e79b077a072dbe954da15
# See: https://lists.9front.org/9front/2024/April/1714325162.00
secstore=localhost

# OSC 7
fn osc7{
	enc=`{echo `{pwd} | sed 's/%/%25/g; s/ /%20/g'}
	p=`{printf '\033]7;file://%s%s\033\\' `{uname -n} $enc}
	if(~ $#TMUX 1)
		printf '%s' $p > `{tmux display-message -p '#{client_tty}'}
	if not
		printf '%s' $p
}

# cd - set hooks
fn cd{
	if(~ $#* 0)
		builtin cd
	if not
		builtin cd $*

	osc7 $*
}

# special characters
tab='	'
nl='
'
cr='
'

# prompt - : ~/bin %
# ../bin/openbsd/prompt2.go
fn prompt1{
	sys=`{prompt2}
	ps1='%'
	prompt=(': '^$"sys^' '^$ps1^' ')
	fn ':'^' '^$sys^' '^$ps1^' ' { if(! ~ $#* 0) $* }
}
fn cd { builtin cd $* && prompt1 }
prompt1

# See: http://man.9front.org/1/emacs
fn acme{SHELL=hack builtin acme -a $varfont $fixfont $*}
fn edwood{SHELL=hack builtin edwood -a $varfont $fixfont $*}
fn sam{builtin sam -a $*}

# fns
fn ck{cmake $*}
fn cp{builtin cp -i $*}
fn hg{chg $*}
fn ivy{ivy-prompt}
fn jk{just $*}
fn lc{builtin lc -F $*}
fn ll{builtin ls -AFl $*}
fn ls{builtin ls -AF $*}
fn ltr{builtin ls -AlFtr $*}
fn m{make $*}
fn mg{builtin mg -n $*}
fn me{muon $*}
fn mv{builtin mv -i $*}
fn ph{ps auwwx | head $*}

# For 9term and acme's win.
if(~ $#termprog 1 || ~ $#winid 1){
	# plumb files instead of starting new editor
	EDITOR=editinacme
	# get rid of backspace characters in Unix man output
	PAGER=nobs
	# prompt - : {uname -n};
	sys=`{uname -n|sed 's/\..*//'}
	ps1='; '
	prompt=(':'^' '^$sys^$ps1 $tab)
	fn ':'^' '^$sys^';' { if(! ~ $#* 0) $* }
	# sets the current window label using awd (see label(1))
	fn cd {
		# builtin cd $1 && flag i && awd
		# is not sufficient when running in a subshell
		# that is rc -e (like mk uses!)
		if(builtin cd $1){
			if(flag i) awd || status=''
			status=''
		}
	}
	awd
	# no paging
	fn git{builtin git --no-pager $*}
	fn hg{chg --pager=no $*}
	fn ivy{builtin ivy}
	fn jj{builtin jj --no-pager $*}
}

# revpatch - reverse a patch
# 24may2020  +leah+
fn revpatch { interdiff -q $1 /dev/null }

# OS specificities.
switch($os){
case linux
	BROWSER=zen-browser
	NPROC=`{nproc}
	fn ls{builtin ls -AFv $*}
	fn orphrem{run0 pacman -R `{pacman -Qdtq}}
	fn pQm{pacman -Qm}
	fn ph{ps auwwx | sort -rk 3,3 | head}
case openbsd
	# See: https://www.omarpolo.com/post/enjoying-cdpath.html
	cdpath=(/usr/ports /usr/ports/mystuff)
	fn cvs{opencvs $*}
	fn mpldc{make port-lib-depends-check}
	fn mup{make update-patches}
	fn mupl{make update-plist $*}
	fn pclean{make clean='package plist'}
	fn rsync{openrsync $*}
}

if(! ~ $os linux){
	NPROC=`{sysctl -n hw.ncpu}
	stty status '^T'
}

# Use $NPROC for parallelism.
MAKEFLAGS=-j$NPROC
SAMUFLAGS=-j$NPROC

ulimit -c 0

# Make sure these are running.
fn felloff{
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Start factotum before secstore so it does not prompt for a password.
	if(! test -e $NAMESPACE/font) fontsrv &
	if(! test -e $NAMESPACE/factotum) factotum &
	if(! test -e $NAMESPACE/plumb) plumber &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `{9 ssh-agent}
}

if(test -d $PLAN9) felloff

# Site local config.
# . -q $home/lib/profile.local
