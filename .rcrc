os=`{uname -s | tr '[:upper:]' '[:lower:]'}
arch=`{uname -m | sed 's/x86_64/amd64/'}
path=(/usr/local/bin /usr/local/sbin /bin /usr/bin /sbin /usr/sbin /usr/X11R6/bin)
BIN=($home/bin $home/bin/$os $home/bin/$os/$arch)
PLAN9=/usr/local/plan9

# XDG
XDG_CACHE_HOME=$home/.cache
XDG_CONFIG_HOME=$home/.config
XDG_DATA_HOME=$home/.local/share

# XDG offenders...
# https://wiki.archlinux.org/title/XDG_Base_Directory#Partial
CARGO_HOME=$XDG_DATA_HOME/cargo
CUDA_CACHE_PATH=$XDG_CACHE_HOME/nv
NUGET_PACKAGES=$XDG_CACHE_HOME/NuGetPackages
RUFF_CACHE_DIR=$XDG_CACHE_HOME/ruff
RUSTUP_HOME=$XDG_DATA_HOME/rustup

append=(/usr/games /usr/games/bin $PLAN9/bin $PLAN9/bin/upas)
prepend=($BIN $home/.local/bin $home/go/bin $CARGO_HOME/bin)
path=($prepend $path $append)

# == SITE LOCAL CONFIG
if(test -r $home/.rcrc.local) . $home/.rcrc.local # XXX: . -q

# Browser used by web(1) and thus plumber.
BROWSER=firefox

LESS=FRXi

CVS_RSH=/usr/bin/ssh

GOT_AUTHOR=('demian garcia <sfyatee@sfyatee.com>')

# Let gs find the plan9port document fonts.
GS_FONTPATH=$PLAN9/postscript/font

# When I was a child, I used to speak like a child, think like a child,
# reason like a child; when I became a man, I did away with childish
# things.
#
# -rob
NO_COLOR=1
CMAKE_COLOR_MAKEFILE=OFF
AV_LOG_FORCE_NOCOLOR=1

TOG_COLORS=yes
TOG_COLOR_DIFF_MINUS=magenta
TOG_COLOR_DIFF_PLUS=blue
TOG_COLOR_DIFF_CHUNK_HEADER=green
TOG_COLOR_DIFF_META=default
TOG_COLOR_COMMIT=default
TOG_COLOR_AUTHOR=default
TOG_COLOR_DATE=default
TOG_COLOR_REFS_REMOTES=red

TF2=$home^'/.local/share/Steam/steamapps/common/Team Fortress 2/tf/custom'

# Unix means english and 24h clock. but do use UTF-8! and sort like a machine.
LANG=en_US.UTF-8
LC_CTYPE=$LANG
LC_COLLATE=C
LC_TIME=C

# https://youtu.be/2jdM_WdrvGY?si=D1renRZL3lep6kWs
CLAUDE_CONFIG_DIR=$XDG_CONFIG_HOME/claude
CODEX_HOME=$XDG_CONFIG_HOME/codex
COPILOT_HOME=$XDG_CONFIG_HOME/copilot
DO_NOT_TRACK=true
GOTELEMETRY=off
GOTOOLCHAIN=local
MOZ_USE_XINPUT2=1
OLLAMA_MODELS=$XDG_DATA_HOME/ollama/models
_JAVA_AWT_WM_NONREPARENTING=1

PACMAN_AUTH=run0
SYSTEMD_RUN_SHELL_PROMPT_PREFIX=(': ')

# 福山
HISTFILE=/dev/null
HISTSIZE=5000
LESSHISTFILE=/dev/null
MYSQL_HISTFILE=/dev/null
PYTHON_HISTORY=/dev/null

# Override $NAMESPACE (see intro(4)).
# bin/riostart:3
# https://github.com/rsc/tmp/blob/master/ssh-namespace-agent/main.go#L446
# /usr/local/plan9/src/lib9/getns.c:16
NAMESPACE=/tmp/ns.$LOGNAME.:0

secstore=localhost

# Prompt
H=`{uname -n}
h=`{echo $H |sed 's/\-..*//'}	# XXX: $ifs^'.-'{printf %s $H}
sys=$h(1)
PS1=$sys'=; '
h=()

fn :{}
ps1='% '
tab='	'
nl='
'

PWD=`{pwd}
lwd=$PWD
fn cwd{
	cwd=$PWD
	switch($cwd){
	case /;		echo -n /
	case $home;	echo -n '~'
	case *
		parts=`/{echo $cwd}
		root=no
		if(~ $cwd $home/*){
			root=yes
			if(~ $#split 0)
				split=`/{echo $home}
			for(part in $split)
				parts=$parts(2-)
		}

		tail=()
		trunc=no
		for(part in $parts)
			if(! ~ $part ''){
				tail=($tail $part)
				if(~ $#tail 3){
					tail=$tail(2-)
					trunc=yes
				}
			}

		switch($#tail){
		case 0;	echo -n /
		case 1
			if(~ $root yes)	echo -n '~/'^$tail
			if not		echo -n '/'^$tail
		case *
			if(~ $root yes || ~ $trunc yes)
				echo -n $tail(1)^/$tail(2)
			if not
				echo -n '/'^$tail(1)^'/'^$tail(2)
		}
	}
}

fn sfprompt{
	prompt=($"sys^':'^`$nl{cwd}^$ps1)
}

# Report current working directory at each prompt.
fn osc7{
	enc=`{printf '%s' $"PWD | sed 's/%/%25/g; s/ /%20/g'}
	p=`{printf '\033]7;file://%s%s\033\\' $H $enc}
	printf '%s' $"p
	# ; sshfs -s $HOSTNAME -r / $HOSTNAME
	# ; plumb 'Local mount -c /srv/$HOSTNAME /n/$HOSTNAME'
	# Run uname -n on Unix to determine $HOSTNAME.
	if(~ $"TMUX ?*)
		printf '%s' $"p >`{tmux display-message -p '#{client_tty}'}
}

fn title{
	printf '\033]0;%s:%s$\007' $sys $dir
}

fn hook{
	if(flag i){
		osc7
		sfprompt
		title
	}
	status=''
}

fn cd{
	odir=$PWD

	switch($#*){
	case 0
		arg=()
	case 1
		switch($1){
		case -
			arg=$lwd
		case *
			arg=$1
		}
	case *
		arg=$*
	}

	if(builtin cd $arg){
		PWD=`{pwd}

		if(! ~ $odir $PWD)
			lwd=$odir

		hook
	}
}

fn cp{builtin cp -i $*}
fn gl{tog $*}
fn hg{chg $*}
fn ivy{ivy-prompt}
fn lc{builtin lc -F $*}
fn ll{builtin ls -AFl $*}
fn ls{builtin ls -AF $*}
fn ltr{builtin ls -AlFtr $*}
fn mg{builtin mg -n $*}
fn mv{builtin mv -i $*}
fn publicip{curl -4 -w '\n' -s http://ifconfig.me}
fn snarf{git --git-dir $home^'/lib/dotfiles' --work-tree $home $*}

# Default font for Plan 9 programs.
font2=/mnt/font/LucidaGrande/11a/font
varfont=(-f $font2)
font=/mnt/font/LucidaGrandeMonoDK/11a/font
fixfont=(-F $font)

hx=`{which hx>[2]/dev/null}
if(~ $#hx 1 && test -x $kak){
	fn vi{$hx $*}
	fn view{$hx $*}
	EDITOR=$hx
}
if not{
	fn vi{/usr/bin/vi $*}
	fn view{/usr/bin/view $*}
	EDITOR=/usr/bin/vi
}

if(~ $#termprog 1 || ~ $#winid 1){
	# Plumb files instead of starting new editor.
	EDITOR=editinacme
	# Get rid of backspace characters in Unix man output.
	PAGER=nobs
	# Make prompt executable.
	prompt=($sys^'% ' $tab)
	fn $sys^'%' { if(! ~ $#* 0) $* }
	# Set the current window label using awd (see label(1))
	fn hook{ if(flag i) { awd }; status='' }; awd
	# 9 utilis
	fn gl{
		root=`{git rev-parse --show-toplevel}
		got log $* |
			plumb -i -d edit -a ('action=showdata filename='^$root^'/+log')
	}
	# No paging
	fn git{builtin git --no-pager $*}
	fn hg{chg '--pager=no' $*}
	fn ivy{builtin ivy}
	fn jj{builtin jj --no-pager $*}
}
if not hook

cdpath=(.)

switch($os){
case linux
	NPROC=`{nproc}

	fn ls{builtin ls -AFv $*}
	fn pclean{makepkg -C $*}
	fn pstree{ps -e f -ww -o pid,args}
	fn rcctl{systemctl $*}
case openbsd
	cdpath=($cdpath /usr/src/^(bin sbin usr.^(bin sbin)) /usr/ports^('' /mystuff))

	# https://dots.omarpolo.com/kshrc.html
	fn cshlib{
		libs=`{make 'show=SHARED_LIBS'}

		while(! ~ $#libs 0){
			echo '===>' $libs(1)
			/usr/src/lib/check_sym \
				/usr/local/lib/lib$libs(1).so* \
				`{make 'show=WRKINST'}/usr/local/lib/lib$libs(1).so*

			shift libs
			shift libs
		}
	}

	fn rcctl{
		if(~ $1 --user){
			shift
			superctl $*
		}
		if not builtin rcctl $*
	}

	if(test `{sysctl -n hw.ncpuonline} -gt 1) MP=.MP; if not MP=''
	fn cdg{cd /usr/src/sys/arch/`{machine}/compile/GENERIC^$MP}
	fn cvs{opencvs $*}
	fn mpldc{make port-lib-depends-check}
	fn mup{make update-patches}
	fn mupl{make update-plist $*}
	fn pclean{make 'clean=package' plist}
	fn pstree{ps -Aww -f -o pid,command}
	fn rsync{openrsync $*}
}

if(! ~ $os linux){
	NPROC=`{sysctl -n hw.ncpu}
	stty status '^T'
}

MAKEFLAGS=-j$NPROC
SAMUFLAGS=-j$NPROC

# ulimit -c 0

fn felloff{
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Start factotum before secstore so it does not prompt for a password.
	if(! test -e $NAMESPACE/font) fontsrv &
	if(! test -e $NAMESPACE/factotum) factotum &
	if(! test -e $NAMESPACE/plumb) plumber &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `{9 ssh-agent}
}

if(test -d $PLAN9) felloff
