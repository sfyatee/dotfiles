# 𝑩𝑰	𝑯𝒆𝒍𝒍𝒐, 𝒘𝒐𝒓𝒍𝒅! 𝜞𝜺𝜾𝜶 𝝈𝝄𝝊 𝜥𝝄𝝈𝝁𝜺! 𝑰𝒕 𝒊𝒔 𝑭𝒓𝒊 20 𝑵𝒐𝒗 2020 18:51:10 𝑮𝑴𝑻 𝒏𝒐𝒘.
# 𝒮𝒸	ℋℯℓℓℴ, 𝓌ℴ𝓇ℓ𝒹! Γεια σου Κοσμε! ℐ𝓉 𝒾𝓈 ℱ𝓇𝒾 20 𝒩ℴ𝓋 2020 18:51:10 𝒢ℳ𝒯 𝓃ℴ𝓌.
# 𝓢𝓫	𝓗𝓮𝓵𝓵𝓸, 𝔀𝓸𝓻𝓵𝓭! Γεια σου Κοσμε! 𝓘𝓽 𝓲𝓼 𝓕𝓻𝓲 20 𝓝𝓸𝓿 2020 18:51:10 𝓖𝓜𝓣 𝓷𝓸𝔀.
# 𝔉	ℌ𝔢𝔩𝔩𝔬, 𝔴𝔬𝔯𝔩𝔡! Γεια σου Κοσμε! ℑ𝔱 𝔦𝔰 𝔉𝔯𝔦 20 𝔑𝔬𝔳 2020 18:51:10 𝔊𝔐𝔗 𝔫𝔬𝔴.
# 𝕱𝕭	𝕳𝖊𝖑𝖑𝖔, 𝖜𝖔𝖗𝖑𝖉! Γεια σου Κοσμε! 𝕴𝖙 𝖎𝖘 𝕱𝖗𝖎 20 𝕹𝖔𝖛 2020 18:51:10 𝕲𝕸𝕿 𝖓𝖔𝖜.
# 𝔻𝕊	ℍ𝕖𝕝𝕝𝕠, 𝕨𝕠𝕣𝕝𝕕! Γεια σου Κοσμε! 𝕀𝕥 𝕚𝕤 𝔽𝕣𝕚 𝟚𝟘 ℕ𝕠𝕧 𝟚𝟘𝟚𝟘 𝟙𝟠:𝟝𝟙:𝟙𝟘 𝔾𝕄𝕋 𝕟𝕠𝕨.
# 𝖧	𝖧𝖾𝗅𝗅𝗈, 𝗐𝗈𝗋𝗅𝖽! Γεια σου Κοσμε! 𝖨𝗍 𝗂𝗌 𝖥𝗋𝗂 𝟤𝟢 𝖭𝗈𝗏 𝟤𝟢𝟤𝟢 𝟣𝟪:𝟧𝟣:𝟣𝟢 𝖦𝖬𝖳 𝗇𝗈𝗐.
# 𝗛𝗕	𝗛𝗲𝗹𝗹𝗼, 𝘄𝗼𝗿𝗹𝗱! 𝝘𝝴𝝸𝝰 𝞂𝝾𝞄 𝝟𝝾𝞂𝝻𝝴! 𝗜𝘁 𝗶𝘀 𝗙𝗿𝗶 𝟮𝟬 𝗡𝗼𝘃 𝟮𝟬𝟮𝟬 𝟭𝟴:𝟱𝟭:𝟭𝟬 𝗚𝗠𝗧 𝗻𝗼𝘄.
# 𝘏𝘐	𝘏𝘦𝘭𝘭𝘰, 𝘸𝘰𝘳𝘭𝘥! Γεια σου Κοσμε! 𝘐𝘵 𝘪𝘴 𝘍𝘳𝘪 20 𝘕𝘰𝘷 2020 18:51:10 𝘎𝘔𝘛 𝘯𝘰𝘸.
# 𝙃𝙓	𝙃𝙚𝙡𝙡𝙤, 𝙬𝙤𝙧𝙡𝙙! 𝞒𝞮𝞲𝞪 𝞼𝞸𝞾 𝞙𝞸𝞼𝞵𝞮! 𝙄𝙩 𝙞𝙨 𝙁𝙧𝙞 20 𝙉𝙤𝙫 2020 18:51:10 𝙂𝙈𝙏 𝙣𝙤𝙬.
# 𝙻	𝙷𝚎𝚕𝚕𝚘, 𝚠𝚘𝚛𝚕𝚍! Γεια σου Κοσμε! 𝙸𝚝 𝚒𝚜 𝙵𝚛𝚒 𝟸𝟶 𝙽𝚘𝚟 𝟸𝟶𝟸𝟶 𝟷𝟾:𝟻𝟷:𝟷𝟶 𝙶𝙼𝚃 𝚗𝚘𝚠.
# LC	Hello, world! Γεια σου Κοσμε! It is Fri 🯲🯰 Nov 🯲🯰🯲🯰 🯱🯸:🯵🯱:🯱🯰 GMT now.

switch($1){
case B # bold
	exec tr A-Za-z0-9Α-Ω∇α-ω∂ϵϑϰϕϱϖ 𝐀-𝐙𝐚-𝐳𝟎-𝟗𝚨-𝛀𝛁𝛂-𝛚𝛛𝛜𝛝𝛞𝛟𝛠𝛡
case I # italic
	exec tr A-Za-ghi-zΑ-Ω∇α-ω∂ϵϑϰϕϱϖ 𝐴-𝑍𝑎-𝑔ℎ𝑖-𝑧𝛢-𝛺𝛻𝛼-𝜔𝜕𝜖𝜗𝜘𝜙𝜚𝜛
case BI # bold italic
	exec tr A-Za-zΑ-Ω∇α-ω∂ϵϑϰϕϱϖ 𝑨-𝒁𝒂-𝒛𝜜-𝜴𝜵𝜶-𝝎𝝏𝝐𝝑𝝒𝝓𝝔𝝕
case Sc # script
	exec tr ABCDEFGHIJKLMN-QRS-Za-defgh-klmnop-z \
		𝒜ℬ𝒞𝒟ℰℱ𝒢ℋℐ𝒥𝒦ℒℳ𝒩-𝒬ℛ𝒮-𝒵𝒶-𝒹ℯ𝒻ℊ𝒽-𝓀ℓ𝓂𝓃ℴ𝓅-𝓏
case Sb # bold script
	exec tr A-Za-z 𝓐-𝓩𝓪-𝔃
case F # fractur
	exec tr ABCD-GHIJK-QRS-YZa-z 𝔄𝔅ℭ𝔇-𝔊ℌℑ𝔍𝔎-𝔔ℜ𝔖-𝔜ℨ𝔞-𝔷
case FB # bold fractur
	exec tr A-Za-z 𝕬-𝖅𝖆-𝖟
case DS # double-struck
	exec tr ABCD-GHI-MNOPQRS-YZa-z0-9 𝔸𝔹ℂ𝔻-𝔾ℍ𝕀-𝕄ℕ𝕆ℙℚℝ𝕊-𝕐ℤ𝕒-𝕫𝟘-𝟡
case H # helvetica (serif)
	exec tr A-Za-z0-9 𝖠-𝖹𝖺-𝗓𝟢-𝟫
case HB	# serif bold
	exec tr A-Za-z0-9Α-Ω∇α-ω∂ϵϑϰϕϱϖ  𝗔-𝗭𝗮-𝘇𝟬-𝟵𝝖-𝝮𝝯𝝰-𝞈𝞉𝞊𝞋𝞌𝞍𝞎𝞏
case HI	# serif italic
	exec tr A-Za-z 𝘈-𝘡𝘢-𝘻
case HX	# serif bold italic
	exec tr A-Za-zΑ-Ω∇α-ω∂ϵϑϰϕϱϖ 𝘼-𝙕𝙖-𝙯𝞐-𝞨𝞩𝞪-𝟂𝟃𝟄𝟅𝟆𝟇𝟈𝟉
case L # monotype
	exec tr A-Za-z0-9 𝙰-𝚉𝚊-𝚣𝟶-𝟿
case LC # segmented LCD
	exec tr 0-9 🯰-🯹
case R # regular - reverse the above back to ASCII
	exec tr \
		𝐀-𝐙𝐚-𝐳𝟎-𝟗𝚨-𝛀𝛁𝛂-𝛚𝛛𝛜𝛝𝛞𝛟𝛠𝛡 ^ \
		𝐴-𝑍𝑎-𝑔ℎ𝑖-𝑧𝛢-𝛺𝛻𝛼-𝜔𝜕𝜖𝜗𝜘𝜙𝜚𝜛 ^ \
		𝑨-𝒁𝒂-𝒛𝜜-𝜴𝜵𝜶-𝝎𝝏𝝐𝝑𝝒𝝓𝝔𝝕  ^ \
		𝒜ℬ𝒞𝒟ℰℱ𝒢ℋℐ𝒥𝒦ℒℳ𝒩-𝒬ℛ𝒮-𝒵𝒶-𝒹ℯ𝒻ℊ𝒽-𝓀ℓ𝓂𝓃ℴ𝓅-𝓏 ^ \
		𝓐-𝓩𝓪-𝔃 ^ \
		𝔄𝔅ℭ𝔇-𝔊ℌℑ𝔍𝔎-𝔔ℜ𝔖-𝔜ℨ𝔞-𝔷 ^ \
		𝕬-𝖅𝖆-𝖟 ^ \
		𝔸𝔹ℂ𝔻-𝔾ℍ𝕀-𝕄ℕ𝕆ℙℚℝ𝕊-𝕐ℤ𝕒-𝕫𝟘-𝟡 ^ \
		𝖠-𝖹𝖺-𝗓𝟢-𝟫 ^ \
		𝗔-𝗭𝗮-𝘇𝟬-𝟵𝝖-𝝮𝝯𝝰-𝞈𝞉𝞊𝞋𝞌𝞍𝞎𝞏 ^ \
		𝘼-𝙕𝙖-𝙯𝞐-𝞨𝞩𝞪-𝟂𝟃𝟄𝟅𝟆𝟇𝟈𝟉 ^ \
		𝙰-𝚉𝚊-𝚣𝟶-𝟿 ^ \
		𝘈-𝘡𝘢-𝘻 ^ \
		🯰-🯹 \
		\
		A-Za-z0-9Α-Ω∇α-ω∂ϵϑϰϕϱϖ  ^ \
		A-Za-ghi-zΑ-Ω∇α-ω∂ϵϑϰϕϱϖ  ^ \
		A-Za-zΑ-Ω∇α-ω∂ϵϑϰϕϱϖ  ^ \
		ABCDEFGHIJKLMN-QRS-Za-defgh-klmnop-z ^ \
		A-Za-z ^ \
		ABCD-GHIJK-QRS-YZa-z ^ \
		A-Za-z  ^ \
		ABCD-GHI-MNOPQRS-YZa-z0-9 ^ \
		A-Za-z0-9 ^ \
		A-Za-z0-9Α-Ω∇α-ω∂ϵϑϰϕϱϖ ^ \
		A-Za-zΑ-Ω∇α-ω∂ϵϑϰϕϱϖ ^ \
		A-Za-z0-9 ^ \
		A-Za-z ^ \
		0-9
case  *
	echo 'usage: tfont {B | I | BI | Sc | Sb | F | FB | DS | H | HB | HX | HI | HBI | L | LC | R}' >[2=1]
	exit 'usage'
}
