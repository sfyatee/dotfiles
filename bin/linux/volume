#!/bin/sh

app=volume
sink='@DEFAULT_AUDIO_SINK@'

volume()
{
	wpctl get-volume "$sink" |
		awk '{ printf "%d\n", $2 * 100 }'
}

muted()
{
	wpctl get-volume "$sink" |
		grep -q '\[MUTED\]'
}

send()
{
	notify-send -a "$app" -u normal -t 800 \
		-h 'string:x-canonical-private-synchronous:volume' "$@"
}

volnotify()
{
	v=$(volume)

	send -i audio-volume-muted-blocking \
		-h "int:value:$v" Volume "${v}%"
}

mutenotify()
{
	send -i audio-volume-muted Mute
}

case ${1-} in
up)
	wpctl set-mute "$sink" 0
	wpctl set-volume -l 1.0 "$sink" 5%+
	volnotify
	;;

down)
	wpctl set-mute "$sink" 0
	wpctl set-volume -l 1.0 "$sink" 5%-
	volnotify
	;;

mute)
	wpctl set-mute "$sink" toggle

	if muted; then
		mutenotify
	else
		volnotify
	fi
	;;

*)
	printf 'usage: %s {up|down|mute}\n' "$0" >&2
	exit 2
	;;
esac
