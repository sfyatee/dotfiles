#!/bin/sh
set -eu

u=""
o=""
while [ "$#" -gt 0 ]; do
	case "$1" in
	-u) u=$2; shift 2 ;;
	-n) o="$o --no-ask-password"; shift ;;
	-s) o="$o --via-shell";       shift ;;
	-i) o="$o -i";                shift ;;
	--) shift; break ;;
	*) break ;;
	esac
done

[ -n "$u" ] && o="--user=$u$o"
# shellcheck disable=SC2086
exec run0 $o "$@"
