#!/usr/bin/env rc
u=''
o=()
scan=on
while(! ~ $#* 0 && ~ $scan on){
	switch($1){
	case -u
		u=$2
		shift 2
	case -n
		o=($o --no-ask-password)
		shift
	case -s
		o=($o --via-shell)
		shift
	case -i
		o=($o -i)
		shift
	case --
		shift
		scan=off
	case *
		scan=off
	}
}
if(! ~ $u '')
	o=(--user=$u $o)
exec run0 $o $*
