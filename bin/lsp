#!/bin/rc
# acme-lsp helpers
# adapted from: https://9lab.org/9port/acme-with-lsp/
if(~ `{which systemctl >[2]/dev/null} ?*){
	rcctl=(systemctl --user)
	rclist=(systemctl --user list-units -t service -a)
}
if not{
	# https://sr.ht/~craftyguy/superd/
	rcctl=(superctl)
	rclist=(superctl status)
}
# https://pkg.go.dev/9fans.net/acme-lsp@master
services=(acme-lsp acmefocused)
fn usage{echo `{basename $0}^' [list|start|stop|restart|log]'}
switch($1){
case list
	$rclist | grep acme
case start
	for(s in $services) $rcctl enable --now $s
case stop
	for(s in $services) $rcctl disable --now $s
case restart
	for(s in $services)
		$rcctl restart $s
case log
	if(~ $rcctl(1) systemctl){
		args=()
		for(s in $services) args=($args -u $s)
		journalctl --user $args
	}
	if not for(s in $services) $rcctl log $s
case *
	usage
}
