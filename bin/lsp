#!/bin/rc
# lsp: systemd and superd helper script for acme-lsp
# Dependencies:
# https://man.archlinux.org/man/systemd.service.5.en
# https://git.sr.ht/~craftyguy/superd
# ../.config/systemd/user/acme-lsp.service
# ../.config/systemd/user/acmefocused.service
# Prior art:
# https://9lab.org/9port/acme-with-lsp/
# https://github.com/xmonk/p9p/blob/master/bin/alsp
services=(acme-lsp acmefocused)
if(~ `{which systemctl >[2]/dev/null} ?*){
	rcctl=(systemctl --user)
	rclist=($rcctl list-units -t service -a)
}
if not{
	rcctl=(superctl)
	rclist=($rcctl status)
}
fn usage{
	echo `{basename $0}^' [list|start|stop|restart|log]'
}
switch($1){
case list
	$rclist | grep acme
case start
	for(s in $services) $rcctl enable --now $s
case stop
	for(s in $services) $rcctl disable --now $s
case restart
	for(s in $services) $rcctl restart $s
case log
	if(~ $rcctl(1) systemctl){
		args=()
		for(s in $services) args=($args -u $s)
		journalctl --user $args
	}
	if not{
		state=$home/.local/state
		logs=$state^'/superd/logs/'^$services^'.log'
		tail -f $logs
	}
case *
	usage
}
