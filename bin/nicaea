#!/bin/sh
# nicaea - quick'n'dirty byzanz(1)-like screencast tool
 
[ "$1" = -w ] && shift && window=1

[ -z "$1" ] && echo >&2 "Usage: $0 [-w] output"; exit 1

[ "$window" ] && { geometry=$(slurp) || exit 1; }

out=$1
set --
[ "$geometry" ] && set -- -g "$geometry"
wf-recorder "$@" -r 2 -c gif -f "$out.gif"
