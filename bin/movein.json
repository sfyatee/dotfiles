{
	"audio_config": { "audio": "pipewire" },
	"bootloader": "Systemd-boot",
	"uki": true,
	"kernels": [ "linux" ],
	"packages": [
		"clang",
		"blender",
		"firefox",
		"fnott",
		"foot",
		"fzf",
		"gammastep",
		"gcc-m2",
		"github-cli",
		"glab",
		"go",
		"go-tools",
		"gopls",
		"graphviz",
		"jujutsu",
		"libreoffice-fresh",
		"lilypond",
		"mandoc",
		"obs-studio",
		"openbsd-netcat",
		"pacman-contrib",
		"prismlauncher",
		"prusa-slicer",
		"qemu-full",
		"racket",
		"ruff",
		"rustup",
		"sequoia-sq",
		"sshfs",
		"steam",
		"syncthing",
		"tailscale",
		"tmux",
		"ttf-hack",
		"typst",
		"wayvnc",
		"wev",
		"xwayland-satellite"
	],
	"profile_config":
	"custom-command": [
		"cd /tmp; git clone https://aur.archlinux.org/paru.git; cd paru; makepkg -si",
		"paru -S --noconfirm gameoftrees knfmt minivmac ttf-{apple-emoji,mac-fonts,ms-fonts}",
		"systemctl --user enable --now {fnott,foot-server,gammastep,syncthing}.service"
	],
	"services": "mandoc", "paccache", "tailscale"
}
