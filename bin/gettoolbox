#!/bin/sh

go install 9fans.net/go/acme/Watch@master
go install github.com/cptaffe/acme-tab@latest
mv -f $(go env GOPATH)/bin/acme-tab tab
go install github.com/rjkroege/edwood/cmd/win@master
go install robpike.io/ivy@master
go install rsc.io/rf@master

raco pkg install racket-langserver

if [ -z "$(rustup toolchain list | grep -v 'default')" ]; then
	rustup toolchain install stable
	rustup default stable
else
	rustup update
fi

cargo install --git https://github.com/bergercookie/asm-lsp asm-lsp
cargo install --git https://github.com/sfyatee/acre acre
