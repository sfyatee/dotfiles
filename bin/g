#!/bin/zsh

# g  +leah+
g() {
	LC_ALL=C grep \
	${${(M)@:#+*}:s/+/--include=*./} \
	--exclude "*~" --exclude "*.o" --exclude "tags" \
	--exclude-dir .bzr --exclude-dir .git --exclude-dir .hg --exclude-dir .svn \
	--exclude-dir CVS  --exclude-dir RCS --exclude-dir _darcs \
	--exclude-dir _build \
	--line-buffered -n -r ${${@:#+*}:?regexp missing}
}

g "$@"
