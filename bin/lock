#!/bin/sh

D=`date`
echo "[$D] locking"

# kill any active tokens
ssh-add -D
if [ `uname -s` = "OpenBSD" ]; then
	doas -L
else
	# pkcheck(1)
	# pkcheck --revoke-temp && sudo -k
fi

# clear clipboard
wl-copy -c
wl-copy -p -c

# http://man.9front.org/8/screenlock
# https://github.com/sfyatee/screenlock/
# screenlock
