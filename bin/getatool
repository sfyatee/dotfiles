#!/bin/sh

export OS=$(uname)

# opts
export GOTELEMETRY=off
export GOTOOLCHAIN=local
export RUSTUP_HOME=$HOME/.local/share/rustup

case "$OS" in
Linux)
	RUNAUTH="run0"
	Tux
	;;
OpenBSD)
	RUNAUTH="doas"
	$RUNAUTH pkg_add -l $HOME/bin/openbsd/movein.txt
	;;
esac

# Dangerous and stupid.
# https://inbox.vuxu.org/9fans/dd6fe68a1001241127j2f5bed0em5f3eee1699342f@mail.gmail.com/
# $RUNAUTH mkdir -r /n
# $RUNAUTH chmod 755 /mnt
# $RUNAUTH chown $(id -un) /mnt

# https://9fans.github.io/plan9port/
if [ ! -d /usr/local/plan9 ]; then
	$RUNAUTH mkdir -p /usr/local/plan9
	$RUNAUTH chgrp $(id -gn) /usr/local/plan9
	$RUNAUTH chmod g+rwx /usr/local/plan9
	$RUNAUTH chown $(id -un):$(id -gn) /usr/local/plan9
	git clone -b sfyatee https://github.com/sfyatee/plan9port.git /usr/local/plan9
	cd /usr/local/plan9; ./INSTALL
else
	cd /usr/local/plan9; git pull; ./INSTALL
fi

Tux() {
	# Install/Update rust toolchain
	# rustup not available(recommended?) on OpenBSD
	if [ -z "$(rustup toolchain list | grep -v 'default')" ]; then
		rustup toolchain install stable
	else
		rustup update
	fi
	# Load 9p kernel module if not enabled
	if ! lsmod | grep -q 9p; then
		run0 mkdir -p /etc/modules-load.d/
		echo 9p | $RUNAUTH tee -a /etc/modules-load.d/9p.conf > /dev/null
	fi
	# AUR helper
	if ! command -v yay >/dev/null 2>&1; then
		git clone https://aur.archlinux.org/yay /tmp/yay
		cd /tmp/yay || exit 1; makepkg -fsi --noconfirm
	fi
}

cd ~

cargo install --git https://github.com/bergercookie/asm-lsp asm-lsp
go install github.com/fzipp/ivy-prompt@latest
go install github.com/hdonnay/wercsrv@master
go install github.com/rjkroege/edwood/cmd/win@master
go install robpike.io/ivy@master
go install rsc.io/rf@master
go install git.sr.ht/~gzj/werc-quickstart@latest
raco pkg install --auto --batch racket-langserver
