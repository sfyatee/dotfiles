#!/bin/sh
set -eu

die() {
	printf 'inst: %s\n' "$*" >&2
	exit 1
}

v="$HOME/v"
disk="$v/9front.amd64.qcow2"
if [ -e "$disk" ]; then
	printf 'Already exists: %s\n' "$disk" >&2
	exit 0
fi

mkdir -p "$v"

src=${src:-https://build.9front.org/9front}
qemu=${QEMU:-qemu-system-x86_64}
latest=$(curl -fsSL "${src%/}/latest")
image="$v/9front-$latest.amd64.qcow2"
archive="$image.gz"

cleanup() {
	rm -f "$archive.tmp.$$" "$image.tmp.$$" "$disk.tmp.$$"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

if [ ! -f "$image" ]; then
	if [ ! -f "$archive" ]; then
		url="${src%/}/9front-$latest.amd64.qcow2.gz"
		curl -fL "$url" -o "$archive.tmp.$$" || die "download failed"
		mv "$archive.tmp.$$" "$archive"
	fi

	gzip -dc "$archive" >"$image.tmp.$$"
	mv "$image.tmp.$$" "$image"
	rm -f "$archive"
fi

qemu-img create -f qcow2 "$disk.tmp.$$" 50G >/dev/null
qcow2="$image" disk="$disk.tmp.$$" QEMU=$qemu expect "$(dirname "$0")/inst.exp"

mv "$disk.tmp.$$" "$disk"
printf 'Created %s\n' "$disk"
