#!/bin/sh

mem=4G
smp=4
mac=mac=52:54:00:12:34:56
while getopts ':G' name; do
	case $name in
	G)	nogui=1 ;;
	?)	echo "usage: q9 [-G]" >&2; exit 1 ;;
	esac
done

slirp="-device virtio-net-pci,netdev=net0,$mac -netdev user,id=net0"

exec qemu-system-x86_64 -m $mem -smp $smp \
	$slirp

drawterm -u glenda -h localhost -a localhost
