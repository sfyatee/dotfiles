#!/bin/sh
# See: http://fqa.9front.org/fqa3.html#3.3.1.4.2

createimg(){
	qemu-img create -f qcow2 9front.amd64.qcow2 40G
}
case "$1" in
-qcow2new)
	createimg
	;;
esac

qemu-system-x86_64 -cpu host -m 4G -smp 4 \
	-net nic,model=virtio,macaddr=00:20:91:37:33:77 -net user \
	-device virtio-scsi-pci,id=scsi \
	-drive if=none,id=vd0,file=9front.amd64.qcow2 \
	-device scsi-hd,drive=vd0 \
	-drive if=none,id=vd1,file=9front.iso \
	-device scsi-cd,drive=vd1,bootindex=0
