#!/bin/sh
# See: http://fqa.9front.org/fqa3.html#3.3.1.4.2

set -e

# configure
export FELLOFF=$HOME/vm
export FLAGS='-m 4G -smp 4 -device virtio-scsi-pci,id=scsi'
export OS=`uname`

createimg(){
	qemu-img create -f qcow2 $FELLOFF/* 64G
}
installqcow2(){
	qemu-system-x86_64 $FLAGS
}
case "$1" in
-qcow2new)
	createimg
	;;
esac

qemu-system-x86_64 $FLAGS \
	-net nic,model=virtio,macaddr=00:20:91:37:33:77 -net user \
	-drive if=none,id=vd0,file=$FELLOFF/9front.amd64.qcow2 \
	-device scsi-hd,drive=vd0 \
	-drive if=none,id=vd1,file=$FELLOFF/9front.iso \
	-device scsi-cd,drive=vd1,bootindex=0
