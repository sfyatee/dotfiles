#!/bin/sh
# See: http://fqa.9front.org/fqa3.html#3.3.1.4.2

set -e

# configure
export FELLOFF=$HOME/vm
export FLAGS='-m 4G -smp 4 '
export OS=`uname`

createimg(){
	qemu-img create -f qcow2 $FELLOFF/* 64G
}
installqcow2(){
	qemu-system-x86_64 $FLAGS
}
case "$1" in
-qcow2new)
	createimg
	;;
esac

qemu-system-x86_64 $FLAGS -drive file=$FELLOFF/9front.amd64.qcow2,media=disk,if=virtio,index=0
