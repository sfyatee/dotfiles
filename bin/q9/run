#!/bin/sh
set -eu

mem=4G
smp=4
nogui=0
disk="$HOME/v/9front.amd64.qcow2"
qemu=${QEMU:-qemu-system-x86_64}

case $(uname -s) in
Darwin) drawterm=${DRAWTERM:-/Applications/drawterm.app/drawterm} ;;
*)      drawterm=${DRAWTERM:-drawterm} ;;
esac

unset NAMESPACE

usage() {
	echo 'usage: q9/run [-G] [-M memory] [-s cpus] [-d disk]' >&2
}

while getopts ':M:s:d:G' name; do
	case $name in
	M) mem=$OPTARG ;;
	s) smp=$OPTARG ;;
	d) disk=$OPTARG ;;
	G) nogui=1 ;;
	:) printf 'run: -%s requires an argument\n' "$OPTARG" >&2; exit 2 ;;
	\?) usage; exit 2 ;;
	esac
done
shift $((OPTIND - 1))
[ "$#" -eq 0 ] || { usage; exit 2; }

if [ ! -f "$disk" ]; then
	printf 'could not find %s\n' "$disk" >&2
	exit 1
fi

kvm=0
if [ -w /dev/kvm ]; then
	kvm=1
fi

QEMU="$qemu" DRAWTERM="$drawterm" DISK="$disk" MEM="$mem" SMP="$smp" \
KVM="$kvm" NOGUI="$nogui" \
	expect "$(dirname "$0")/run.exp"
