#!/bin/sh

# Services.
gui() {
	if ! pgrep -x "footclient" >/dev/null 2>&1; then
		foot -s
	fi
}

felloff() {
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Use mntgen(1) for /mnt.
	# https://github.com/musolinoa/mntgen/tree/master
	~/go/bin/mntgen /mnt &
	# Mount factotum(4) because we can.
	9p stat factotum 2>/dev/null 1>&2 factotum -m /mnt/factotum &
	# pal's go port of plumber(4) does not fork.
	# https://github.com/paul-lalonde/plumber/blob/main/plumber/fsys.go#L148
	9p stat plumb 2>/dev/null 1>&2 || plumber &
	# fontsrv(4) on OSX and the go port does not fork.
	9p stat font 2>/dev/null 1>&2 || fontsrv -m /mnt/font &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `9 ssh-agent -e`
}

# Use systemd services instead.
# if [ $OS = linux ]; then
 	gui
 	felloff
# fi

swaybg -m center -i $HOME/.local/share/backgrounds/grendel.png &

# Applications.
footclient aerc &
footclient comlink &

# Default font for Plan 9 programs.
lookforfont() {
	font="$(fontsrv -p .)"
	for family in "$@"; do
		case "$font" in
		*"$family/"*)
			echo "/mnt/font/$family/11a/font"
			return 0
		;;
		esac
	done
	return 1
}

# sans-serif
varfont=""
font2="$(lookforfont LucidaGrande Geneva GoRegular IBMPlexSans)"
[ -n "$font2" ] && varfont="-f $font2"

# monospace
fixfont=""
font="$(lookforfont LucidaGrandeMonoDK Monaco GoMono IBMPlexMono)"
[ -n "$font" ] && fixfont="-F $font"

dump=""
if [ -f "$HOME/acme.dump" ]; then
	dump="-l $HOME/acme.dump"
fi

# http://man.9front.org/1/emacs
SHELL=hack acme -a $varfont $fixfont $dump &

zen-browser &
