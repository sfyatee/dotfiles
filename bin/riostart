#!/usr/bin/env rc

# services
# making sure these are running
fn felloff{
	mkdir -p $NAMESPACE
	9p stat plumb >[2]/dev/null >[1=2] || plumber
}

felloff

swaybg -m center -i $home/.local/share/backgrounds/grendel.png &

# applications
footclient aerc &
footclient comlink &

dump=()
if(test -f $home/acme.dump){
	dump=(-l $home/acme.dump)
}

acme -a $dump &

zen-browser &
