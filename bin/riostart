#!/bin/rc
fn felloff{
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Start factotum before secstore so it does not prompt for a password.
	if(! test -e $NAMESPACE/font) fontsrv &
	if(! test -e $NAMESPACE/factotum) factotum &
	if(! test -e $NAMESPACE/plumb) plumber &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `{9 ssh-agent -e}
}

# Setups up the Plan 9 enviornment with an user service supervisor.
# Systems without systemd(1) can use: https://sr.ht/~craftyguy/superd/
#
# Dependencies:
# ../.config/systemd/user/factotum.service
# ../.config/systemd/user/fontsrv.service
# ../.config/systemd/user/plumber.service
# Prior art:
# https://github.com/NixOS/nixpkgs/pull/18228
# https://github.com/lufia/plan9port-systemd-units/

# Insurance, just in case the service supervisor somehow fails.
if(! test -e $NAMESPACE/font ||
	! test -e $NAMESPACE/factotum ||
	! test -e $NAMESPACE/plumb) felloff

# Default font for Plan 9 programs.
fn lookforfont{
	@{
		font=`{fontsrv -p .}
		for(family in $*)
			if(~ $font *$family/*){
				echo /mnt/font/$family/11a/font
				exit
			}
	}
}

# sans-serif
varfont=()
font2=`{lookforfont LucidaGrande GoRegular LuxiSans Geneva IBMPlexSans}
if(! ~ $#font 0) varfont=(-f $font2)

# monospace
fixfont=()
font=`{lookforfont LucidaGrandeMonoDK GoMono LuxiMono Monaco IBMPlexMono}
if(! ~ $#font 0) fixfont=(-F $font)

# Restore the state of acme from a file.
dump=()
if(test -f $home/acme.dump)
	dump=(-l $home/acme.dump)

# For these Plan 9 programs, the Wayland backend for devdraw doesn't allow
# specifying @x.y for -W winsize. Wayland doesnt allow windows to position
# themselves. This is by design... The general workaround is to set
# compositor-specific rules. Your milage may vary. Welcome to the future! ʕ◔ϖ◔ʔ
#
# Of interest:
# ../.config/cow/cow.conf:374
# https://cow-wm.codeberg.page/cow/man/release/cow.1.html#WINDOW_COMMANDS
# https://github.com/eaburns/plan9port/blob/wayland/src/cmd/devdraw/wayland.c
# https://github.com/tw4452852/plan9port/blob/master/src/cmd/devdraw/wayland.c
#
# 9 man stats, or...
# /usr/local/plan9/src/cmd/auxstats
# /usr/local/plan9/src/cmd/draw/stats.c
stats -W 500x100@0,0 -lmisce $fixfont

# http://man.9front.org/1/emacs
# https://research.swtch.com/acme
/usr/local/plan9/bin/acme -a $varfont $fixfont $dump &
