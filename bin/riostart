#!/usr/bin/env rc

# services
# start factotum before secstore so it does not prompt for a password
# load secrets manually using ipso
fn felloff{
	mkdir -p $NAMESPACE
	for(proc in fontsrv factotum){
		pgrep -x '^'^$proc > /dev/null
		switch($status) {
		case 1
			$proc -m /mnt/$proc &
		}
	}
	9p stat plumb >[2]/dev/null >[1=2] || plumber
}

if (! ~ $OS linux) felloff

swaybg -m center -i $home/.local/share/backgrounds/grendel.png &

# applications
footclient aerc &
footclient comlink &

dump=()
if(test -f $home/acme.dump){
	dump=(-l $home/acme.dump)
}

acme -a $dump -m /mnt/acme &

zen-browser &
