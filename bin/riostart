#!/bin/sh

# Magic variables for the strange and stranger...
export XDG_SESSION_TYPE=wayland
# magic variable for java apps refusing to work
export _JAVA_AWT_WM_NONREPARENTING=1
export MOZ_ENABLE_WAYLAND=1
# better two-finger touchpad scrolling
export MOZ_USE_XINPUT2=1

gui() {
	if ! pgrep -x "footclient" >/dev/null 2>&1; then
		foot -s &
	fi
}

felloff() {
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Start factotum before secstore so it does not prompt for a password.
	[ -e "$NAMESPACE/font" ] || fontsrv &
	[ -e "$NAMESPACE/factotum" ] || factotum &
	[ -e "$NAMESPACE/plumb" ] || plumber &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `9 ssh-agent -e`
}

# Use systemd services instead.
if [ $OS = linux ]; then
	gui
	felloff
fi

swaybg -m center -i $HOME/.local/share/backgrounds/7564218.webp -c a3ccbd &

foot aerc &
foot senpai &

# Default font for Plan 9 programs.
lookforfont() {
	font="`fontsrv -p .`"
	for family in "$@"; do
		case "$font" in
		*"$family/"*)
			echo "/mnt/font/$family/11a/font"
			return 0
		;;
		esac
	done
}

# sans-serif
varfont=""
font2="`lookforfont LucidaGrande LuxiSans Geneva GoRegular IBMPlexSans`"
[ -n "$font2" ] && varfont="-f $font2"

# monospace
fixfont=""
font="`lookforfont LucidaGrandeMonoDK LuxiMono Monaco GoMono IBMPlexMono`"
[ -n "$font" ] && fixfont="-F $font"

dump=""
if [ -f "$HOME/acme.dump" ]; then
	dump="-l $HOME/acme.dump"
fi

# See: http://man.9front.org/1/emacs
SHELL=hack acme -a $varfont $fixfont $dump &

# https://9front.org
if [ $OS = linux ]; then
	nyxt &
else
	firefox &
fi
