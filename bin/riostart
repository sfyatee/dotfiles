#!/bin/sh

# force wayland on firefox
export MOZ_ENABLE_WAYLAND=1

gui() {
	footclient 2>/dev/null || foot -s &
	wlsunet 2>/dev/null || wlsunset -l 34 -L -118.6 &
}

felloff() {
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Start factotum before secstore so it does not prompt for a password.
	[ -e "$NAMESPACE/font" ] || fontsrv &
	[ -e "$NAMESPACE/factotum" ] || factotum &
	[ -e "$NAMESPACE/plumb" ] || plumber &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `9 ssh-agent -e`
}

# Use systemd services instead.
if [ $OS = linux ]; then
	gui
	felloff
fi

# I'm afraid it's terminal...
# foot/tmux

# Default font for Plan 9 programs.
lookforfont() {
	font="`fontsrv -p .`"
	for family in "$@"; do
		case "$font" in
		*"$family/"*)
			echo "/mnt/font/$family/11a/font"
			return 0
		;;
		esac
	done
}

# sans-serif
varfont=""
font2="`lookforfont LucidaGrande GoRegular LuxiSans Geneva IBMPlexSans`"
[ -n "$font2" ] && varfont="-f $font2"

# monospace
fixfont=""
font="`lookforfont LucidaGrandeMonoDK GoMono LuxiMono Monaco IBMPlexMono`"
[ -n "$font" ] && fixfont="-F $font"

# https://9front.org
dump=""
if [ -f "$HOME/acme.dump" ]; then
	dump="-l $HOME/acme.dump"
fi

# For these Plan 9 programs, the Wayland backend for devdraw does
# not allow specifying -W winsize. The general workaround is to
# set compositor-specific rules. Welcome to the future! ʕ◔ϖ◔ʔ
# See ../.config/cow/cow.conf:369 and cow(1) (fvwm3 for Wayland)
#
# 9 man stats
# See: /usr/local/plan9/src/cmd/auxstats
# See: /usr/local/plan9/src/cmd/draw/stats.c
stats -lmisce $fixfont

# See: http://man.9front.org/1/emacs
# See: https://research.swtch.com/acme
SHELL=hack /usr/local/plan9/bin/acme -a $varfont $fixfont $dump &
