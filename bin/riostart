#!/bin/sh

# Setups up the Plan 9 enviornment. Acme and friends need the $(namespace).
felloff() {
	# Override $NAMESPACE (see intro(4)) because $WSYS is not running yet.
	mkdir -p $NAMESPACE
	# Start factotum before secstore so it does not prompt for a password.
	[ -e "$NAMESPACE/font" ] || fontsrv &
	[ -e "$NAMESPACE/factotum" ] || factotum &
	[ -e "$NAMESPACE/plumb" ] || plumber &
	# Plan 9 ssh-agent connects to factotum(4).
	# eval `9 ssh-agent -e`
}

# Setups up the Plan 9 enviornment with a user service supervisor.
# Systems without systemd(1) can use: https://sr.ht/~craftyguy/superd/
#
# Modify to your preferences:
# ../.config/systemd/user/acme-lsp.service
# ../.config/systemd/user/acmefocused.service
# ../.config/systemd/user/factotum.service
# ../.config/systemd/user/fontsrv.service
# ../.config/systemd/user/plumber.service
#
# superctl enable -now plumber.service
# superctl enable -now acme-lsp.service

# Insurance, just in case the service supervisor somehow fails.
[ -e "$NAMESPACE/font" ] &&
[ -e "$NAMESPACE/factotum" ] &&
[ -e "$NAMESPACE/plumb" ] || felloff

# Default font for Plan 9 programs.
lookforfont() {
	font="`fontsrv -p .`"
	for family in "$@"; do
		case "$font" in
		*"$family/"*)
			echo "/mnt/font/$family/11a/font"
			return 0
		;;
		esac
	done
}

# sans-serif
varfont=""
font2="`lookforfont LucidaGrande GoRegular LuxiSans Geneva IBMPlexSans`"
[ -n "$font2" ] && varfont="-f $font2"

# monospace
fixfont=""
font="`lookforfont LucidaGrandeMonoDK GoMono LuxiMono Monaco IBMPlexMono`"
[ -n "$font" ] && fixfont="-F $font"

# Restore the state of acme from a file.
dump=""
if [ -f "$HOME/acme.dump" ]; then
	dump="-l $HOME/acme.dump"
fi

# For these Plan 9 programs, the Wayland backend for devdraw doesn't allow specifying @x.y
# for -W winsize. Wayland doesnt allow windows to position themselves. This is by design...
# The general workaround is to set compositor-specific rules. Welcome to the future! ʕ◔ϖ◔ʔ
#
# Of interest:
# ../.config/cow/cow.conf:369 and https://codeberg.org/cow-wm/cow (fvwm for Wayland).
# https://github.com/eaburns/plan9port/blob/wayland/src/cmd/devdraw/wayland.c
# https://github.com/tw4452852/plan9port/blob/master/src/cmd/devdraw/wayland.c
#
# 9 man stats, or...
# /usr/local/plan9/src/cmd/auxstats
# /usr/local/plan9/src/cmd/draw/stats.c
stats -lmisce $fixfont

# http://man.9front.org/1/emacs
# https://research.swtch.com/acme
SHELL=hack /usr/local/plan9/bin/acme -a $varfont $fixfont $dump &
