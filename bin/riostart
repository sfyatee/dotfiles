#!/bin/sh

# services
gui(){
	if ! pgrep -x "footclient" >/dev/null 2>&1; then
		foot -s
	fi
}
felloff(){
	# override $NAMESPACE (see intro(4)) because $WSYS is not running yet
	mkdir -p $NAMESPACE
	# use mntgen(1) for /mnt
	mntgen /mnt
	# start factotum before secstore so it does not prompt for a password
	# load secrets manually using ipso
	for proc in fontsrv factotum; do
		if ! pgrep -x "$proc" >/dev/null 2>&1; then
			"$proc" -m "/mnt/$proc" &
		fi
	done
	# 9p stat plumb >[2]/dev/null >[1=2] || plumber &
}

# use systemd services instead
# if(! ~ $OS linux)
 	gui
 	felloff

swaybg -m center -i $HOME/.local/share/backgrounds/grendel.png &

# applications
footclient aerc &
footclient comlink &

dump=""
if [ -f "$HOME/acme.dump" ]; then
	dump="-l $HOME/acme.dump"
fi

SHELL=hack acme -a $dump &

zen-browser &
