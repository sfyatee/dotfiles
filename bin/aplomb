#!/usr/bin/env rc
# aplomb - send text to the Plan 9 plumber(4) from tmux copy mode

nl='
'
fn copy{tmux $* ';' save-buffer - ';' delete-buffer}
fn sel{ifs=(){text=`{copy send-keys -X copy-selection}}}

fn click{
	ifs=(){
		p=`{copy \
			send-keys -X begin-selection ';' \
			send-keys -X previous-space ';' \
			send-keys -X copy-selection}

		text=`{copy \
			send-keys -X begin-selection ';' \
			send-keys -X next-space ';' \
			send-keys -X -N 2 cursor-left ';' \
			send-keys -X copy-selection}
	}

	pos=`{printf '%s\n' $p | awk '{print length($0) - 1}'}
}

fn main{
	ifs=$nl{
		state=`{tmux \
			display-message -p '#{selection_present}' ';' \
			display-message -p '#{pane_current_path}'}
	}

	sel=$state(1)
	cwd=$state(2)
	text=()
	pos=-1
	if(~ $sel 0){
		click
	}
	if not{
		sel
		if(~ $"text '' ?) click
	}

	args=(plumb -s tmux -w $cwd)
	if(! ~ $pos -1)
		args=($args -a 'click='^$pos)

	args=($args $text)
	err=`{$args >[2=1]}
	if(~ $status '') exit

	tmux display-message -- $"err
	exit 1
}

main
