#!/bin/sh
# aplomb - send text to the Plan 9 plumber(4) from tmux copy mode

text=''
i=-1

sel() {
	tmux send-keys -X copy-selection \; show-buffer \; delete-buffer
}

click() {
	p="$(tmux \
		send-keys -X begin-selection \; \
		send-keys -X previous-space \; \
		send-keys -X copy-selection \; \
		show-buffer \; \
		delete-buffer)"

	text="$(tmux \
		send-keys -X begin-selection \; \
		send-keys -X next-space \; \
		send-keys -X -N 2 cursor-left \; \
		send-keys -X copy-selection \; \
		show-buffer \; \
		delete-buffer)"

	i=$(( ${#p} - 1 ))
}

main() {
	if [ "$(tmux display-message -p '#{selection_present}')" = 0 ]; then
		click
	else
		text="$(sel)"
		[ "${#text}" -le 1 ] && click
	fi

	wd="$(tmux display-message -p '#{pane_current_path}')"
	set -- 9 plumb -s tmux -w "$wd"
	if [ "$i" -ge 0 ]; then
		set -- "$@" -a "click=$i"
	fi
	set -- "$@" "$text"

	err="$("$@" 2>&1)" || tmux display-message -- "$err"
}

main "$@"
